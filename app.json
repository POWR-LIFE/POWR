{
  "expo": {
    "name": "POWR",
    "slug": "POWR",
    "version": "1.4.11",
    "orientation": "portrait",
    "icon": "./assets/images/ios_icon_black.png",
    "scheme": "powr",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.powr.life",
      "buildNumber": "12",
      "googleServicesFile": "./GoogleService-Info.plist",
      "associatedDomains": ["applinks:powr.life"],
      "infoPlist": {
        "NSHealthShareUsageDescription": "POWR needs access to your sleep and workout data to reward you for healthy habits.",
        "NSHealthUpdateUsageDescription": "POWR needs access to log your habits.",
        "UIBackgroundModes": ["location", "fetch", "remote-notification"],
        "CFBundleURLTypes": [
          {
            "CFBundleURLSchemes": ["powr"]
          }
        ],
        "ITSAppUsesNonExemptEncryption": false
      },
      "entitlements": {
        "aps-environment": "production"
      }
    },
    "android": {
      "config": {
        "googleMaps": {
          "apiKey": ""
        }
      },
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/images/powr_icon_foreground.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_LOCATION",
        "android.permission.health.READ_STEPS",
        "android.permission.health.READ_EXERCISE",
        "android.permission.health.READ_SLEEP",
        "android.permission.health.READ_HEART_RATE",
        "android.permission.health.READ_RESTING_HEART_RATE",
        "android.permission.health.READ_ACTIVE_CALORIES_BURNED",
        "android.permission.health.READ_TOTAL_CALORIES_BURNED",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS",
        "android.permission.VIBRATE",
        "android.permission.CAMERA"
      ],
      "blockedPermissions": [
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED"
      ],
      "package": "com.powr.life",
      "versionCode": 15,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": false,
          "data": [
            { "scheme": "powr", "host": "auth-callback" },
            { "scheme": "powr", "host": "terra-callback" },
            { "scheme": "powr", "host": "samsung-health-callback" }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        },
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            { "scheme": "https", "host": "powr.life", "pathPrefix": "/app" }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
            "icon": "./assets/images/ic_stat_powr_logo_black.png",
          "color": "#facc15",
          "defaultChannel": "powr_default_v2",
          "sounds": []
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/powr_transparent.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#000000",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "POWR uses your location to detect when you arrive at partner gyms and automatically track your workouts.",
          "locationWhenInUsePermission": "POWR uses your location to show nearby partner gyms and rewards.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true
        }
      ],
      "expo-video",
      "expo-asset",
      [
        "expo-camera",
        {
          "cameraPermission": "POWR uses your camera to scan a friend's code so you can connect.",
          "recordAudioAndroid": false
        }
      ],
      "react-native-health-connect",
      "./withHealthConnectMainActivity.js",
      "./withHealthConnectManifestQueries.js",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26,
            "compileSdkVersion": 35,
            "targetSdkVersion": 35
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": false
    }
  }
}
