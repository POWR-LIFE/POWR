{
  "expo": {
    "name": "POWR",
    "slug": "POWR",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/ios_icon_black.png",
    "scheme": "powr",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.powr.life",
      "googleServicesFile": "./GoogleService-Info.plist",
      "infoPlist": {
        "NSHealthShareUsageDescription": "POWR needs access to your sleep and workout data to reward you for healthy habits.",
        "NSHealthUpdateUsageDescription": "POWR needs access to log your habits.",
        "CFBundleURLTypes": [
          {
            "CFBundleURLSchemes": ["powr"]
          }
        ],
        "ITSAppUsesNonExemptEncryption": false
      },
      "entitlements": {
        "aps-environment": "production"
      }
    },
    "android": {
      "config": {
        "googleMaps": {
          "apiKey": ""
        }
      },
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/images/powr_icon_foreground.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_LOCATION",
        "android.permission.health.READ_STEPS",
        "android.permission.health.READ_EXERCISE",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.VIBRATE"
      ],
      "package": "com.powr.life",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": false,
          "data": [
            { "scheme": "powr", "host": "auth-callback" },
            { "scheme": "powr", "host": "fitbit-callback" },
            { "scheme": "powr", "host": "whoop-callback" },
            { "scheme": "powr", "host": "samsung-health-callback" }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
            "icon": "./assets/images/ic_stat_powr_logo_black.png",
          "color": "#facc15",
          "defaultChannel": "powr_default_v2",
          "sounds": []
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/powr_transparent.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#000000",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "POWR uses your location to detect when you arrive at partner gyms and automatically track your workouts.",
          "locationWhenInUsePermission": "POWR uses your location to show nearby partner gyms and rewards.",
          "isIosBackgroundLocationEnabled": false,
          "isAndroidBackgroundLocationEnabled": true
        }
      ],
      "expo-video",
      "expo-asset",
      "react-native-health-connect",
      "./withHealthConnectMainActivity.js",
      "./withHealthConnectManifestQueries.js",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26,
            "compileSdkVersion": 35,
            "targetSdkVersion": 35
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": false
    }
  }
}
